    "custom_grab": false
  },
  {
    "title": "即日起,郑州住房公积金贷款实现“一证办”",
    "link": "https://baijiahao.baidu.com/s?id=1833260463325372028&wfr=spider&for=pc",
    "fetchdate": "2025-05-27",

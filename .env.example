# 复制此文件为 .env 并填入真实密钥（.env 已被 .gitignore 忽略）

# 新闻 API
SERPAPI_KEY=your_serpapi_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# AI 大模型
DEEPSEEK_API_KEY=your_deepseek_api_key_here
BAILIAN_API_KEY=your_bailian_api_key_here

# MySQL 数据库
MYSQL_HOST=your_mysql_host_here
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user_here
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=serp_news

# 数据表（开发测试用 scored_news_test，上线改回 scored_news）
MYSQL_TABLE=scored_news_test

# 可选：流程控制开关
ENABLE_ITEM_SUMMARIZER=1

# Flask 前端
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# 管理后台认证
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# 飞书通知（可选，不配置则不发送）
FEISHU_USER_ID=your_feishu_user_id_here
LARK_CLI_PATH=/Users/babyowen/.nvm/versions/node/v24.11.0/bin/lark-cli

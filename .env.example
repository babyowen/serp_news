# 复制此文件为 .env 并填入真实密钥（.env 已被 .gitignore 忽略）

# 运行配置：先按 docs/configuration.md 显式初始化，再填入部署目录之外的绝对路径
SERP_CONFIG_STORE=/absolute/path/outside/project/runtime.sqlite3
# SERP_CONFIG_REVISION 仅用于单次任务指定历史版本，不要长期写入这里

# 新闻 API
SERPAPI_KEY=your_serpapi_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# AI 大模型
DEEPSEEK_API_KEY=your_deepseek_api_key_here
BAILIAN_API_KEY=your_bailian_api_key_here

# MySQL 数据库
MYSQL_HOST=your_mysql_host_here
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user_here
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=serp_news

# 数据表（开发测试用 scored_news_test，上线改回 scored_news）
MYSQL_TABLE=scored_news_test

# 可选：流程控制开关
ENABLE_ITEM_SUMMARIZER=1
# 仅在维护窗口执行一次索引迁移；日常批次保持 0
AUTO_MIGRATE_DEDUP_INDEX=0

# Flask 前端
# 生产多 worker 请设置共享的随机会话密钥
# 留空会产生临时密钥并输出告警；重启使旧表单失效，多 worker 可能校验失败
FLASK_SECRET_KEY=
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# 管理后台认证
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# 飞书通知（可选，不配置则不发送）
# 接收人 open_id（私聊）
FEISHU_USER_ID=your_feishu_user_id_here

# 发送方式一：lark-cli（本机 macOS 推荐；需要 npm install -g lark-cli + lark-cli auth login）
LARK_CLI_PATH=/Users/babyowen/.nvm/versions/node/v24.11.0/bin/lark-cli

# 发送方式二：飞书开放平台 API（Linux 服务器推荐；纯 Python 无需 Node.js）
# 当 LARK_CLI_PATH 指向的文件不存在时自动降级到此方式
# 这两个值来自飞书开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
